# Cadena de conexión de Postgres (Neon: usa la URL "pooled").
DATABASE_URL=postgres://usuario:password@host/db?sslmode=require

# Solo para crear la cuenta del administrador la primera vez (en /admin).
# En cuanto existe, se ignora: bórrala. Las cuentas viven en la tabla users.
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar las sesiones del panel y anonimizar IPs (mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Fotos (Vercel Blob). Vercel la agrega sola al conectar un Blob store al proyecto.
# BLOB_READ_WRITE_TOKEN=
# Solo en desarrollo, sin Blob: guarda las fotos en public/uploads.
# STORAGE_DRIVER=local
